{
  "name": "TJ Volume Mixer",
  "description": "Per-tab volume control and boost (up to 600%) for Chrome",
  "version": "2.0.0",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "TJ Volume Mixer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["js/volume-core.js", "js/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "logo/logo-16.png",
    "48": "logo/logo-48.png",
    "128": "logo/logo-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
